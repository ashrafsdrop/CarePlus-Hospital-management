@{
    ViewData["Title"] = "Create Account - CarePlus";
    ViewData["HideHeaderFooter"] = true;
}

<!-- Auth Section -->
<section class="min-h-screen flex items-center justify-center pt-24 pb-12 px-4 sm:px-6 lg:px-8 relative bg-[#020617] overflow-hidden">
    <!-- Mesh Background -->
    <div class="absolute inset-0 z-0 mesh-cta opacity-50"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E'); mix-blend-mode: overlay;"></div>

    <div class="relative z-10 w-full max-w-xl reveal">
        <!-- Card -->
        <div class="glass-dark rounded-[2.5rem] p-8 sm:p-10 shadow-2xl border border-white/10 bg-slate-900/60 backdrop-blur-3xl">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-secondary to-primary mb-6 shadow-lg shadow-secondary/20">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 19v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2m16-10a4 4 0 11-8 0 4 4 0 018 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M22 11v2m-2-2h4" /></svg>
                </div>
                <h2 class="text-3xl font-display font-bold text-white tracking-tight">Join CarePlus</h2>
                <p class="text-sm text-slate-400 mt-2">Create an account to manage your health data</p>
            </div>

            <form class="space-y-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" for="firstName">First name</label>
                        <input type="text" id="firstName" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="John" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" for="lastName">Last name</label>
                        <input type="text" id="lastName" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Doe" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" for="email">Email address</label>
                    <input type="email" id="email" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="you@example.com" />
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" for="password">Password</label>
                    <input type="password" id="password" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Create a strong password" />
                </div>

                <div class="flex items-start">
                    <input type="checkbox" id="terms" class="mt-1 w-4 h-4 rounded bg-white/5 border-white/10 text-primary focus:ring-primary focus:ring-offset-slate-900" />
                    <label for="terms" class="ml-2 text-sm text-slate-400 leading-relaxed">
                        I agree to the <a href="#" class="text-primary hover:text-accent transition-colors">Terms of Service</a> and <a href="#" class="text-primary hover:text-accent transition-colors">Privacy Policy</a>.
                    </label>
                </div>

                <button type="button" class="w-full bg-gradient-to-r from-primary to-secondary hover:from-accent hover:to-primary text-white font-semibold py-3.5 rounded-xl shadow-lg shadow-primary/25 transition-all duration-500 mt-4">
                    Create Account
                </button>
            </form>

            <div class="mt-8 text-center text-sm text-slate-400">
                Already have an account? 
                <a href="~/Patient/Login" class="font-semibold text-white hover:text-primary transition-colors">Sign in instead</a>
            </div>
        </div>
    </div>
</section>
