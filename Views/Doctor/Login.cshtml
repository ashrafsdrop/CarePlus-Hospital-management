@model HospitalManagementSystem.Models.Doctor
@{
    ViewData["Title"] = "Doctor Login - CarePlus";
    ViewData["HideHeaderFooter"] = true;
}

<!-- Auth Section -->
<section class="min-h-screen flex items-center justify-center pt-20 pb-12 px-4 sm:px-6 lg:px-8 relative bg-[#020617] overflow-hidden">
    <!-- Mesh Background -->
    <div class="absolute inset-0 z-0 mesh-cta opacity-50"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E'); mix-blend-mode: overlay;"></div>

    <div class="relative z-10 w-full max-w-md reveal">
        <!-- Card -->
        <div class="glass-dark rounded-[2.5rem] p-8 sm:p-10 shadow-2xl border border-white/10 bg-slate-900/60 backdrop-blur-3xl">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-primary to-accent mb-6 shadow-lg shadow-primary/20">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                </div>
                <h2 class="text-3xl font-display font-bold text-white tracking-tight">Doctor Portal</h2>
                <p class="text-sm text-slate-400 mt-2">Sign in with your staff credentials</p>
            </div>

            <form asp-action="Login" method="post" class="space-y-5">
                <div asp-validation-summary="All" class="text-red-400 text-sm mb-4"></div>
                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="Email">Email address</label>
                    <input type="email" asp-for="Email" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="doctor@careplus.com" />
                    <span asp-validation-for="Email" class="text-red-400 text-xs mt-1 block"></span>
                </div>
                
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-sm font-medium text-slate-300" asp-for="Password">Password</label>
                        <a href="#" class="text-xs font-semibold text-primary hover:text-accent transition-colors">Forgot password?</a>
                    </div>
                    <input type="password" asp-for="Password" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center">
                    <input type="checkbox" id="remember" name="remember" class="w-4 h-4 rounded bg-white/5 border-white/10 text-primary focus:ring-primary focus:ring-offset-slate-900" />
                    <label for="remember" class="ml-2 text-sm text-slate-400">Remember me</label>
                </div>

                <button type="submit" class="w-full bg-primary hover:bg-accent text-white font-semibold py-3.5 rounded-xl shadow-lg shadow-primary/25 transition-all duration-300 mt-2">
                    Sign in to portal
                </button>
            </form>

            <div class="mt-8 text-center text-sm text-slate-400">
                Are you a patient? 
                <a href="~/Patient/Login" class="font-semibold text-white hover:text-primary transition-colors">Login here</a>
            </div>
        </div>
    </div>
</section>
