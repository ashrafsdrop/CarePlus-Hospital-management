@model HospitalManagementSystem.Models.Doctor
@{
    ViewData["Title"] = "Doctor Signup - CarePlus";
    ViewData["HideHeaderFooter"] = true;
    var departments = ViewBag.Departments as IEnumerable<HospitalManagementSystem.Models.Department>;
}

<!-- Auth Section -->
<section class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 relative bg-[#020617] overflow-hidden">
    <!-- Mesh Background -->
    <div class="absolute inset-0 z-0 mesh-cta opacity-50"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E'); mix-blend-mode: overlay;"></div>

    <div class="relative z-10 w-full max-w-2xl reveal">
        <!-- Card -->
        <div class="glass-dark rounded-[2.5rem] p-8 sm:p-10 shadow-2xl border border-white/10 bg-slate-900/60 backdrop-blur-3xl">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-primary to-accent mb-6 shadow-lg shadow-primary/20">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" /></svg>
                </div>
                <h2 class="text-3xl font-display font-bold text-white tracking-tight">Staff Registration</h2>
                <p class="text-sm text-slate-400 mt-2">Create your professional portal account</p>
            </div>

            <form asp-action="Signup" method="post" class="space-y-6">
                <div asp-validation-summary="All" class="text-red-400 text-sm mb-4"></div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="FullName">Full Name</label>
                        <input type="text" asp-for="FullName" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Dr. Sarah Ahmed" />
                        <span asp-validation-for="FullName" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="Email">Email Address</label>
                        <input type="email" asp-for="Email" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="doctor@careplus.com" />
                        <span asp-validation-for="Email" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="Password">Password</label>
                        <input type="password" asp-for="Password" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="Phone">Phone Number</label>
                        <input type="tel" asp-for="Phone" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="+1 (555) 000-0000" />
                        <span asp-validation-for="Phone" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="Specialization">Specialization</label>
                        <input type="text" asp-for="Specialization" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="e.g. Cardiologist" />
                        <span asp-validation-for="Specialization" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="DepartmentId">Department</label>
                        <select asp-for="DepartmentId" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all appearance-none" style="background-color: #0f172a;">
                            <option value="">-- Select Department --</option>
                            @if(departments != null)
                            {
                                foreach(var dept in departments)
                                {
                                    <option value="@dept.Id">@dept.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-slate-300 mb-2" asp-for="Qualifications">Qualifications / Degrees</label>
                    <input type="text" asp-for="Qualifications" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="e.g. MD, PhD" />
                    <span asp-validation-for="Qualifications" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <button type="submit" class="w-full bg-primary hover:bg-accent text-white font-semibold py-3.5 rounded-xl shadow-lg shadow-primary/25 transition-all duration-300 mt-4">
                    Create Account
                </button>
            </form>

            <div class="mt-8 text-center text-sm text-slate-400">
                Already have a staff account? 
                <a href="~/Doctor/Login" class="font-semibold text-white hover:text-primary transition-colors">Sign in here</a>
            </div>
        </div>
    </div>
</section>
