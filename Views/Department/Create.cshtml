@model HospitalManagementSystem.Models.Department
@{
    ViewData["Title"] = "Create Department";
}

<div class="pt-28 pb-16 min-h-screen bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors mb-4">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
                Back to List
            </a>
            <h1 class="text-3xl font-display font-bold text-slate-900">Create Department</h1>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-rose-500 text-sm mb-4"></div>
                
                <div class="space-y-6">
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-2"></label>
                        <input asp-for="Name" class="modern-input w-full rounded-xl px-4 py-3 text-slate-900" placeholder="Department Name" />
                        <span asp-validation-for="Name" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>
                    
                    <div>
                        <label asp-for="Description" class="block text-sm font-medium text-slate-700 mb-2"></label>
                        <textarea asp-for="Description" rows="4" class="modern-input w-full rounded-xl px-4 py-3 text-slate-900" placeholder="Optional description..."></textarea>
                        <span asp-validation-for="Description" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div class="mt-8">
                    <button type="submit" class="w-full inline-flex justify-center items-center gap-2 px-6 py-3 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-sky-600 transition-colors shadow-lg shadow-primary/20">
                        Create Department
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
