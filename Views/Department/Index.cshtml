@model IEnumerable<HospitalManagementSystem.Models.Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="pt-28 pb-16 min-h-screen bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-display font-bold text-slate-900">Departments</h1>
            <a asp-action="Create" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-white text-sm font-semibold rounded-full hover:bg-sky-600 transition-colors shadow-lg shadow-primary/20">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Add New
            </a>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/50 border-b border-slate-200">
                            <th class="py-4 px-6 text-sm font-semibold text-slate-900">@Html.DisplayNameFor(model => model.Name)</th>
                            <th class="py-4 px-6 text-sm font-semibold text-slate-900">@Html.DisplayNameFor(model => model.Description)</th>
                            <th class="py-4 px-6 text-sm font-semibold text-slate-900 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        @foreach (var item in Model) {
                            <tr class="hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-6">
                                    <span class="font-medium text-slate-900">@Html.DisplayFor(modelItem => item.Name)</span>
                                </td>
                                <td class="py-4 px-6 text-slate-500">
                                    @Html.DisplayFor(modelItem => item.Description)
                                </td>
                                <td class="py-4 px-6 text-right space-x-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-sm font-medium text-primary hover:text-sky-600 transition-colors">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-sm font-medium text-rose-500 hover:text-rose-600 transition-colors">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if(!Model.Any()) {
                <div class="p-8 text-center text-slate-500">
                    No departments found.
                </div>
            }
        </div>
    </div>
</div>
