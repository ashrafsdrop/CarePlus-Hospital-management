@model HospitalManagementSystem.Models.Department
@{
    ViewData["Title"] = "Delete Department";
}

<div class="pt-28 pb-16 min-h-screen bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors mb-4">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
                Back to List
            </a>
            <h1 class="text-3xl font-display font-bold text-slate-900">Delete Department</h1>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-rose-200 overflow-hidden">
            <div class="bg-rose-50 p-6 sm:p-8 border-b border-rose-100">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center">
                        <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-rose-900">Are you sure you want to delete this?</h3>
                        <p class="mt-1 text-sm text-rose-700">This action cannot be undone. This will permanently delete the department and remove it from our servers.</p>
                    </div>
                </div>
            </div>

            <div class="p-6 sm:p-8">
                <dl class="space-y-6 mb-8">
                    <div>
                        <dt class="text-sm font-medium text-slate-500">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="mt-1 text-lg font-semibold text-slate-900">@Html.DisplayFor(model => model.Name)</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-slate-500">@Html.DisplayNameFor(model => model.Description)</dt>
                        <dd class="mt-1 text-base text-slate-700">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</dd>
                    </div>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="flex gap-4">
                        <button type="submit" class="flex-1 inline-flex justify-center items-center gap-2 px-6 py-3 bg-rose-500 text-white text-sm font-semibold rounded-xl hover:bg-rose-600 transition-colors shadow-lg shadow-rose-500/20">
                            Yes, delete it
                        </button>
                        <a asp-action="Index" class="flex-1 inline-flex justify-center items-center gap-2 px-6 py-3 bg-slate-100 text-slate-700 text-sm font-semibold rounded-xl hover:bg-slate-200 transition-colors">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
